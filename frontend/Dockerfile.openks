FROM node:18-alpine as builder

WORKDIR /app

ARG VITE_OPENKS_PORTAL_URL=""
ARG VITE_PLATFORM_PORTAL_URL=""
ENV VITE_OPENKS_PORTAL_URL=${VITE_OPENKS_PORTAL_URL}
ENV VITE_PLATFORM_PORTAL_URL=${VITE_PLATFORM_PORTAL_URL}

COPY package*.json ./

RUN npm config set registry https://registry.npmmirror.com && \
    npm install --production=false --prefer-offline --no-audit

COPY . .

RUN npm run build

FROM nginx:alpine

RUN apk add --no-cache curl

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.openks.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /var/cache/nginx/client_temp && \
    chown -R nginx:nginx /var/cache/nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
