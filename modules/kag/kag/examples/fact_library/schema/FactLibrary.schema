RankingList(榜单): EntityType
	properties:
		description(榜单说明): Text
			index: TextAndVector
		publishOrganization(发布机构): Text
		publishTime(发布时间): Text
		firstSort(一级分类): Text
		secondSort(二级分类): Text
		isOfficial(是否官方): Text
		indicator(指标): Text
			index: TextAndVector
		lzIndustryChain(产业链): Text
