# ============================================
# 智链机器人 Docker 环境变量配置
# ============================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置值
# 3. 不要将 .env 文件提交到版本控制系统
# ============================================

# ============================================
# 时区配置
# ============================================
TZ=Asia/Shanghai

# ============================================
# Neo4j 图数据库配置
# ============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================
# MongoDB 文档数据库配置
# ============================================
MONGODB_URI=mongodb://admin:your_mongodb_password_here@mongodb:27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_mongodb_password_here

# ============================================
# Redis 缓存配置
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# MySQL 数据库配置
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=zhilian_robot
MYSQL_PASSWORD=your_mysql_password_here

# ============================================
# AI 服务配置 (DeepSeek)
# ============================================
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ============================================
# 应用端口配置
# ============================================
BACKEND_PORT=8000
FRONTEND_PORT=80
FLOWER_PORT=5555
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MONGODB_PORT=27017
MYSQL_PORT=3307
REDIS_PORT=6379
