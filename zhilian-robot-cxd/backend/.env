# Application Settings
APP_NAME=智链机器人
APP_VERSION=1.0.0
DEBUG=True
ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
# Neo4j (Docker容器默认配置)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# MongoDB (Docker容器默认配置)
MONGODB_URI=mongodb://admin:password123@mongodb:27017
MONGODB_DATABASE=zhilian_robot

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL (Docker容器默认配置)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password123
MYSQL_DATABASE=zhilian_robot

# AI Model Configuration
# DeepSeek API (Compatible with OpenAI interface)
OPENAI_API_KEY=sk-08266faa1d184709878869666545ea9a
OPENAI_API_BASE=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# Hugging Face
HF_TOKEN=your_huggingface_token
HF_MODEL=bert-base-chinese

# NLP Settings
NER_MODEL=ckiplab/bert-base-chinese-ner
RE_MODEL=hfl/chinese-roberta-wwm-ext

# Crawler Settings
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
CRAWLER_DELAY=2
CRAWLER_CONCURRENT=5

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
